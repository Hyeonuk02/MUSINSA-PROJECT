# Prince Mart 실행 설정 — 팀원 k6/run.sh, spill-recover.sh, dbstate-export.sh가 env로 받는 값(기본값은 팀원 앱).
# 직접 쓰지 말고 tools/run-pm.sh로 실행한다(VU=1 강제). 경로는 저장소 루트 기준.
NS_LEGACY=pm-legacy
NS_NEW=pm-new
TOOL_POD_LEGACY=mesh-check
TOOL_POD_NEW=isolation-injected
CORPUS=tracks/prince-mart/corpus/corpus-v2.json
CORPUS_VALIDATOR=tracks/prince-mart/corpus/validate.py
# Feign 호출의 host는 로드밸런서가 풀기 전의 논리 서비스 이름이다(GENERALIZATION.md 1절)
OBSERVED_HOSTS=ORDER-SERVICE,COUPON-SERVICE,PAYMENT-SERVICE
OBSERVED_TOPICS=payment-events
KAFKA_TOPICS=payment-events
# 서비스:포트:경로:기대코드. order와 coupon은 DB를 읽는 GET, payment는 DB를 읽는 GET이 없어 기동 확인만
READINESS_CHECKS="order:8085:/orders/all:200 coupon:8091:/coupons/all:200 payment:8086:/payments/welcome:200"
CERT_APPS="order coupon payment kafka"
RESET_DEPLOYMENTS="order-mysql coupon-mysql payment-mysql kafka"
CONSUMER_GROUP=order-service
CONSUMER_TOPIC=payment-events
META_APPS="order coupon payment"
CLOCK_DEPLOY=order
DBSTATE_TABLES_FILE=tracks/prince-mart/tools/dbstate-tables.txt
DB_USER=pm
DB_PASSWORD=pm
