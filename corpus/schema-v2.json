{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "corpus-v2.schema.json",
  "title": "Replay corpus v2",
  "description": "Phase 3.2 corpus. v1 대비: Coupon API 경로, 세션 split(learn|eval)·flow(order|coupon|order-coupon), 요청 settle(서비스 간 호출·소비로 생기는 내부 Evidence 홉 선언). 구조 외 규칙은 validate.py가 검사한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sessions"],
  "properties": {
    "version": { "const": "corpus-v2" },
    "sessions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/session" } }
  },
  "$defs": {
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "user", "flow", "split", "requests"],
      "properties": {
        "id": { "type": "string", "pattern": "^S[0-9]{3}$" },
        "user": { "type": "string", "minLength": 1 },
        "flow": { "description": "흐름 유형. 유형마다 learn·eval 세션이 각각 1개 이상(validate.py).", "enum": ["order", "coupon", "order-coupon"] },
        "split": { "description": "Rule 학습/평가 분리(phase3-plan 3절). 규칙은 learn에서만 만들고 eval에서 잰다.", "enum": ["learn", "eval"] },
        "requests": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/request" } }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method", "path"],
      "properties": {
        "id": { "type": "string", "pattern": "^R[0-9]{6}$" },
        "method": { "enum": ["GET", "POST"] },
        "path": { "type": "string", "pattern": "^/api/(orders|coupons)" },
        "headers": {
          "type": "object", "additionalProperties": false,
          "properties": { "Idempotency-Key": { "type": "string", "pattern": "^idem-(slow-)?R[0-9]{6}$" } }
        },
        "body": {
          "oneOf": [
            { "$ref": "#/$defs/createOrderBody" },
            { "$ref": "#/$defs/issueCouponBody" },
            { "$ref": "#/$defs/useCouponBody" }
          ]
        },
        "settle": {
          "description": "이 요청이 만드는 내부 Evidence 홉. k6가 양쪽 스택에서 도착을 폴링하고 run.sh barrier가 기대 집합에 넣는다(D19).",
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["hop", "service", "origin"],
            "properties": {
              "hop": { "type": "string", "pattern": "^0(\\.[he][1-9][0-9]*)+$" },
              "service": { "enum": ["order", "coupon"] },
              "origin": { "enum": ["http", "kafka"] }
            }
          }
        },
        "expectMissing": {
          "description": "validate.py 전용. 그 세션에서 만들지 않은 키를 의도적으로 참조(없는 키 조회 404). k6·엔진은 무시.",
          "const": true
        }
      }
    },
    "createOrderBody": {
      "type": "object", "additionalProperties": false, "required": ["orderKey", "items"],
      "properties": {
        "orderKey": { "type": "string", "pattern": "^ok-R[0-9]{6}$" },
        "items": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["sku", "qty", "price"],
            "properties": {
              "sku": { "type": "string", "minLength": 1 },
              "qty": { "type": "integer", "minimum": 1 },
              "price": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "couponKey": { "type": "string", "pattern": "^ck-R[0-9]{6}$" }
      }
    },
    "issueCouponBody": {
      "type": "object", "additionalProperties": false, "required": ["couponKey", "discountAmount"],
      "properties": {
        "couponKey": { "type": "string", "pattern": "^ck-R[0-9]{6}$" },
        "discountAmount": { "type": "integer", "minimum": 0 }
      }
    },
    "useCouponBody": {
      "type": "object", "additionalProperties": false, "required": ["orderKey"],
      "properties": {
        "orderKey": { "description": "이 세션에서 만든 주문 키, 또는 Coupon 전용 세션의 외부 주문 키 ok-ext-<요청 id>.", "type": "string", "pattern": "^ok-(ext-)?R[0-9]{6}$" }
      }
    }
  }
}
