{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "corpus-v1.schema.json",
  "title": "Replay corpus v1",
  "description": "k6가 읽는 재생 corpus. 세션은 서로 독립이며 본문에 실행 시점 값을 두지 않는다. 구조 외 규칙(id 전역 유일, orderKey 세션 내 참조 등)은 validate.py가 검사한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sessions"],
  "properties": {
    "version": { "const": "corpus-v1" },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/session" }
    }
  },
  "$defs": {
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "user", "requests"],
      "properties": {
        "id": { "type": "string", "pattern": "^S[0-9]{3}$" },
        "user": { "type": "string", "minLength": 1 },
        "requests": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/request" }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method", "path"],
      "properties": {
        "id": {
          "description": "replayRequestId. k6가 X-Replay-Request-Id로 보낸다. 전역 유일.",
          "type": "string",
          "pattern": "^R[0-9]{6}$"
        },
        "method": { "enum": ["GET", "POST"] },
        "path": { "type": "string", "pattern": "^/api/" },
        "headers": {
          "description": "corpus가 지정하는 요청 헤더. X-Replay-Request-Id·X-Run-Id·X-Session-Id·Content-Type은 k6가 붙이므로 여기 두지 않는다.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Idempotency-Key": { "type": "string", "pattern": "^idem-R[0-9]{6}$" }
          }
        },
        "body": { "$ref": "#/$defs/createOrderBody" },
        "expectMissing": {
          "description": "validate.py 전용 표기. 이 요청이 그 세션에서 생성하지 않은 orderKey를 의도적으로 참조함(없는 키 조회 404 경로)을 뜻하며, 'orderKey는 같은 세션 안에서 생성된 것만 참조' 규칙의 예외가 된다. k6와 engine/verify_sameness.py는 이 필드를 무시한다 — 판정은 Evidence 비교로만 한다.",
          "const": true
        }
      }
    },
    "createOrderBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orderKey", "items"],
      "properties": {
        "orderKey": { "type": "string", "pattern": "^ok-R[0-9]{6}$" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sku", "qty", "price"],
            "properties": {
              "sku": { "type": "string", "minLength": 1 },
              "qty": { "type": "integer", "minimum": 1 },
              "price": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
