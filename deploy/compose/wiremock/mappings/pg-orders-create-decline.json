{
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/v1/orders",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.amount == 9999900)]"
      }
    ]
  },
  "response": {
    "status": 400,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "error": {
        "code": "BAD_REQUEST_ERROR",
        "description": "Payment declined by fake PG (fixture: amount 99999)"
      }
    }
  }
}
