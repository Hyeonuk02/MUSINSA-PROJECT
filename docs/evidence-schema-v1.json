        "body": "{\"id\":4,\"orderKey\":\"ok-R000027\",\"items\":[{\"sku\":\"D-1\",\"qty\":2,\"price\":5000}],\"amount\":7000,\"couponKey\":\"ck-R000026\",\"discountAmount\":3000,\"status\":\"PAID\",\"transactionId\":\"tx-idem-R000029\",\"createdAt\":\"2026-09-01T00:00:00Z\"}"
