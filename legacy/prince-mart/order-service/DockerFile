# [LEGACY_CHANGES L-C3] upstream은 미리 빌드된 target/*.jar를 복사했다. 실험 환경에서는
# 소스에서 재현 가능하게 빌드하도록 멀티스테이지로 바꾼다. 런타임 옵션(JAVA_OPTS)은 upstream 값 유지.
# macOS 파일시스템은 대소문자를 구분하지 않아 Dockerfile을 따로 둘 수 없으므로 이 파일을 교체한다.
FROM maven:3.9-eclipse-temurin-21@sha256:99e61abcff91a9b1333463bd8451fb18495d6eba9250ac66a338b518f8278320 AS build
WORKDIR /build
COPY pom.xml .
RUN --mount=type=cache,target=/root/.m2 mvn -q -B dependency:go-offline
COPY src ./src
# [LEGACY_CHANGES L-C4] 결함 주입 실험용 New 버전 빌드(baseline/faults/). FAULT가 비어 있으면(기본) 아무것도 하지 않는다.
# FAULT=PF1이면 추가 빌드 컨텍스트 faults의 PF1-order.patch가 있을 때만 git apply로 적용한다(브랜치를 만들지 않는다).
ARG FAULT=
RUN --mount=type=bind,from=faults,target=/faults \
    if [ -n "$FAULT" ] && [ -f "/faults/$FAULT-order.patch" ]; then \
      git apply --verbose "/faults/$FAULT-order.patch" && echo "applied $FAULT-order.patch"; \
    else echo "no fault patch for order (FAULT='$FAULT')"; fi
RUN --mount=type=cache,target=/root/.m2 mvn -q -B package -DskipTests && cp target/*.jar /build/app.jar

FROM eclipse-temurin:21-jre@sha256:d7051a45dd955e4d5d1db4d3f4269fe13d1c6dff8cc6b7ef89fc8577b96c1982
WORKDIR /app
COPY --from=build /build/app.jar app.jar
# -Duser.timezone=UTC: 시각 관련 동작이 호스트 타임존에 좌우되지 않게 고정한다(hyeonuk-dev services/order와 동일).
ENV JAVA_OPTS="-Xmx384M -Xms256M -XX:+UseSerialGC -Duser.timezone=UTC"
EXPOSE 8085
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
