<?xml version="1.0" encoding="UTF-8"?>
<!--
  Phase 3.2: 검증 레이어(poc.evidence)를 서비스들이 공유하는 라이브러리 모듈로 분리.
  Order·Coupon(·Kotlin New)이 같은 jar를 의존성으로 쓰고 auto-configuration으로 붙는다(비즈니스 코드 수정 없음).
  Spring 의존성은 provided — 버전은 각 서비스(Boot 4.1.1)가 정한다. RestClient 쪽은 서비스에 있을 때만 활성(@ConditionalOnClass).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>poc</groupId>
    <artifactId>evidence-collector</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <properties>
        <java.version>17</java.version>
        <!-- Feign 지원: feign-core 버전은 Spring Cloud BOM으로 정한다. Prince Mart 서비스와 같은 릴리스 트레인 -->
        <spring-cloud.version>2025.1.3</spring-cloud.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Phase 3.3: Kafka 수집(ProducerInterceptor·RecordInterceptor·KafkaTemplate 래핑) — Kafka가 있는 서비스에서만 활성(@ConditionalOnClass) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Feign 외부 호출 전파와 기록(FeignEvidenceCapability) — OpenFeign이 있는 서비스에서만 활성(@ConditionalOnClass) -->
        <dependency>
            <groupId>io.github.openfeign</groupId>
            <artifactId>feign-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 통합 테스트: Prince Mart와 같은 구성(Spring Cloud OpenFeign + LoadBalancer + simple discovery)에서 Capability가 붙는지 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
